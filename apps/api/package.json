{
  "name": "@court-flow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && npm run dev:watch",
    "dev:watch": "concurrently -k \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "npm run build --workspace @court-flow/contracts && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:setup": "npm run build && node dist/infrastructure/database/setup-db.js",
    "test": "npm run build && node dist/modules/queue/queue-rules.test.js && node dist/modules/matches/match-rules.test.js && node dist/modules/auth/auth.service.test.js && node dist/security/security.test.js && node dist/security/http-security.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
