DATABASE_URL=postgresql://postgres:postgres@localhost:5433/courtflow
API_PORT=3001
API_HOST=127.0.0.1
STAFF_PIN=replace-this-with-a-private-8-to-12-digit-pin
SESSION_SECRET=replace-this-with-a-private-random-secret-of-at-least-32-characters
# Set WEB_ORIGINS to exact app origins, comma separated.
# For LAN testing, include the address phones use (for example http://192.168.1.25:5173).
# Production origins must use HTTPS.
# WEB_ORIGINS=
# The local API trusts the Vite proxy (one hop); update for another proxy setup.
TRUST_PROXY_HOPS=1

